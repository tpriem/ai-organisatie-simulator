# Alle omgevingsvariabelen van een omgeving (lokaal in .env.local, op Vercel onder Environment Variables).

# Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Supabase (Project settings > API). De service role key is geheim en hoort nooit in de browser.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=...

# Inloggen (NextAuth v5). Genereer een lange willekeurige waarde, bijvoorbeeld met: npx auth secret
AUTH_SECRET=...

# Mail via Resend. Het afzenderdomein (noreply@...) moet bij Resend geverifieerd zijn.
RESEND_API_KEY=re_...
# Waar storingsmeldingen naartoe gaan (optioneel).
ALERT_EMAIL=
# Publieke basis-url van deze omgeving, zonder slash aan het eind. Wordt in links en mails gebruikt.
SITE_URL=https://www.voorbeeld.nl
# Link naar de privacyverklaring die op de aanleverpagina getoond wordt (optioneel).
NEXT_PUBLIC_PRIVACY_URL=
